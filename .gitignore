# ==========================================
# Root .gitignore for ATS Energy BD Monorepo
# Covers client (Next.js) & server (Node/Express)
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions



# Next.js Build Outputs & Cache
client/.next/
client/out/
.next/
out/
build/
dist/
*/build/
*/dist/

# TypeScript & Debug Logs
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
*/coverage/
*.lcov
.nyc_output

# Temporary files & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Vercel Deployment Cache
.vercel/

# Upload / Temporary runtime files
*/uploads/
uploads/
tmp/
temp/
